# 값을 채워 .env 로 복사한다. .env 는 커밋하지 않는다.
ANTHROPIC_API_KEY=

# 모델 지정. "anthropic:<id>" 또는 "openrouter:<id>" (openrouter 는 `uv sync --extra openrouter` 필요)
CODE_AGENT_MODEL=anthropic:claude-opus-5-5
# low | medium | high | xhigh | max
CODE_AGENT_EFFORT=high
# bash | powershell (비우면 Git Bash 가 있으면 bash, 없으면 powershell)
CODE_AGENT_SHELL=
# 입력 컨텍스트 상한(토큰, 20000~1000000). 이 값의 85% 에서 대화를 요약한다. 비우면 200000
CODE_AGENT_CONTEXT_TOKENS=

# 선택
OPENROUTER_API_KEY=

# Langfuse 트레이스 (선택, `uv sync --extra langfuse` 필요). 두 키가 모두 있을 때만 켜진다.
# 키: Langfuse 프로젝트 설정 > API Keys. 리전 예: https://cloud.langfuse.com(EU), https://jp.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
